{
  "sourceLanguage": "en",
  "strings": {
    "%@’s ChatGPT sign-in has expired. Open chatgpt.com in %@, then try again.": {
      "comment": "Browser name, twice",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@’s ChatGPT sign-in has expired. Open chatgpt.com in %2$@, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de ChatGPT en %1$@ ha caducado. Abre chatgpt.com en %2$@ y vuelve a intentarlo."
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elementos"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elemento"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elementos"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld matches": {
      "comment": "Find status: current match of total",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %#@matches@"
          },
          "substitutions": {
            "matches": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg match"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg matches"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %#@matches@"
          },
          "substitutions": {
            "matches": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg coincidencias"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg coincidencia"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg coincidencias"
                    }
                  }
                }
              }
            }
          }
        }
