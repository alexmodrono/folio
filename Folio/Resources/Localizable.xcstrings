    "Folio can copy your ChatGPT sign-in from a browser. Nothing else is copied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio puede copiar tu sesión de ChatGPT de un navegador. No se copia nada más."
          }
        }
      }
    },
    "Folio can’t find ChatGPT’s message box, so it can’t add your PDF or selections.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio no encuentra el cuadro de mensaje de ChatGPT, así que no puede añadir tu PDF ni tus selecciones."
          }
        }
      }
    },
    "Folio can’t fully work with this version of ChatGPT. Selections are pasted as text.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio no funciona del todo con esta versión de ChatGPT. Las selecciones se pegan como texto."
          }
        }
      }
    },
