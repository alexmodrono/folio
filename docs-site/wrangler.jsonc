{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets Worker for https://pdf.amodrono.com (zone amodrono.com on Cloudflare).
  "name": "folio-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /quickstart/ serves quickstart/index.html; unknown paths get dist/404.html with a 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Wrangler creates the proxied DNS record for the custom domain.
  "routes": [{ "pattern": "pdf.amodrono.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
