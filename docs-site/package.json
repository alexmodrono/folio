{
  "name": "folio-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "HOST=0.0.0.0 node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "build:production": "node --env-file=.env.production scripts/build.mjs",
    "deploy": "npm run build:production && npm run check && wrangler pages deploy --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "cuelume": "^0.2.8",
    "highlight.js": "11.12.0",
    "marked": "18.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
